{
  "name": "apccmma",
  "productName": "APCCMMA",
  "version": "1.0.9",
  "description": "Assumption Parish Church Charismatic Music Ministry App — live Mass presentation console",
  "author": "Our Lady of the Assumption Parish, Davao City",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build && electron-builder",
    "release": "tsc --noEmit && vite build && electron-builder --publish always",
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "rebuild:native": "electron-builder install-app-deps",
    "pack": "tsc --noEmit && vite build && electron-builder --win --dir",
    "dist": "tsc --noEmit && vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.apccmma.churchapp",
    "productName": "APCCMMA Presentation",
    "copyright": "Copyright © Our Lady of the Assumption Parish, Davao City",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kristianmukara94",
        "repo": "music-ministry-app"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/bible",
        "to": "bible"
      }
    ],
    "npmRebuild": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "APCCMMA",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "APCCMMA-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.1.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.1.2",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.1.1",
    "@fontsource/merriweather": "^5.3.0",
    "better-sqlite3": "^11.8.1",
    "electron-updater": "^6.8.11",
    "jszip": "^3.10.2",
    "lucide-react": "^0.469.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wait-on": "^8.0.2"
  }
}
