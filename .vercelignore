# Vercel serves only the website (web/) and the API (api/ with server/lib and server/functions). The desktop app, its
# resources, the tests and the admin scripts are not uploaded.
/src
/electron
/resources
/public
/build
/dist
/dist-electron
/scripts
/release
/out
# tools/ stays out, except build-native.mjs: the API builder runs npm install, whose postinstall calls it. On Linux it
# exits at once, but a missing file fails the whole deploy.
/tools/*
!/tools/build-native.mjs
/db
/server/test
/server/scripts
/index.html
/tv.html
/vite.config.ts
/tsconfig.json
/scratchpad-*.txt
/.github
